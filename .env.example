# PostgreSQL connection string used by Prisma and the app.
# Local embedded database (started with `npm run db:start`):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/salon_inventory"

# Secret used to sign session cookies. Use a long random value in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# Public URL of the app (used for cookie settings in production).
APP_URL="http://localhost:3000"

# Optional: separate database for automated tests (defaults to DATABASE_URL with _test suffix).
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/salon_inventory_test"

# Optional: passwords used by `npm run db:seed` for the demo accounts.
# SEED_OWNER_PASSWORD="Owner@Salon2026!"
# SEED_MANAGER_PASSWORD="Manager@Salon2026!"
